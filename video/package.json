{
  "name": "openform-launch-film",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts OpenformLaunch out/openform-launch.mp4 --codec=h264 --crf=18 --audio-codec=aac --concurrency=2 --image-format=jpeg",
    "render:portrait": "remotion render src/index.ts OpenformPortrait out/openform-launch-portrait.mp4 --codec=h264 --crf=18 --audio-codec=aac --concurrency=2 --image-format=jpeg",
    "still": "remotion still src/index.ts OpenformLaunch out/thumbnail.png --frame=180"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.544",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "^4.0.544"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~5.9.3"
  }
}
