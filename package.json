{
  "name": "openform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "format": "prettier --write src server index.html vite.config.ts tsconfig.json",
    "prebuild": "node scripts/build-seo.mjs",
    "build:pages": "VITE_STATIC_DEMO=true VITE_BASE_PATH=/openform/ npm run build",
    "preview:pages": "VITE_BASE_PATH=/openform/ vite preview --host 127.0.0.1 --port 4173",
    "test:demo": "node --test src/static-store.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
